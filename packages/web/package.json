    "@vitest/ui": "5.0.0",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.14.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
