{
  "name": "@hyperneo/web",
  "version": "0.41.0",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:old": "bun run css:build && bun run --bun css:watch & bun run server:dev",
    "css:build": "tailwindcss --input src/styles.css --output src/styles.out.css",
    "css:watch": "tailwindcss --input src/styles.css --output src/styles.out.css --watch",
    "server:dev": "bun --watch src/index.ts",
    "build:old": "bun run build.ts",
    "start": "NODE_ENV=production bun src/server-prod.ts",
    "typecheck": "bun ../../node_modules/typescript7/bin/tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --reporter dot --coverage"
  },
  "dependencies": {
    "@preact/signals": "2.11.2",
    "clsx": "2.1.1",
    "highlight.js": "11.12.0",
    "katex": "0.16.47",
    "mermaid": "12.0.0",
    "preact": "10.29.8",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "rehype-stringify": "10.0.1",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "superpipe": "0.18.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/preact": "3.2.4",
    "@types/bun": "1.4.2",
    "@vitest/coverage-v8": "5.0.0",
    "@vitest/ui": "5.0.0",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.14.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
