    "clsx": "2.1.1",
    "highlight.js": "11.12.0",
    "katex": "0.16.47",
    "mermaid": "12.0.0",
    "preact": "10.29.8",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "rehype-stringify": "10.0.1",
    "remark-breaks": "4.0.0",
    "remark-cjk-friendly": "2.3.3",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "superpipe": "0.18.0",
    "unified": "11.0.5"
