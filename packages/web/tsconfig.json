{
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["vitest/globals"],
    "paths": {
      "@/*": ["./*"],
      "@hyperneo/shared": ["../shared/src/mod.ts"],
      "@hyperneo/shared/*": ["../shared/src/*"],
      "@hyperneo/ui": ["../ui/src/mod.ts"],
      "@hyperneo/ui/*": ["../ui/src/*"]
    }
  },
  "include": ["src/**/*", "../shared/src/**/*", "../ui/src/**/*"],
  "exclude": ["node_modules", "dist", "tests/**/*", "../shared/src/sdk/**/*"]
}
