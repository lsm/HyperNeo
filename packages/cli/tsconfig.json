{
  "compilerOptions": {
    "lib": ["ESNext"],
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["bun"],
    "paths": {
      "@/*": ["./src/*"],
      "@hyperneo/shared": ["../shared/src/mod.ts"],
      "@hyperneo/shared/*": ["../shared/src/*"],
      "@hyperneo/daemon": ["../daemon/main.ts"],
      "@hyperneo/daemon/*": ["../daemon/src/*"],
      "@hyperneo/neo": ["../neo/src/index.ts"]
    }
  },
  "include": ["src/**/*", "main.ts", "prod-entry.ts"],
  "exclude": ["node_modules", "dist", "tests/**/*", "test-*.ts", "src/embedded-assets.ts"]
}
