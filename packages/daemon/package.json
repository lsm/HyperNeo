{
  "name": "@hyperneo/daemon",
  "version": "0.49.0",
  "type": "module",
  "license": "Apache-2.0",
  "main": "main.ts",
  "exports": {
    ".": "./main.ts",
    "./app": "./src/app.ts",
    "./config": "./src/config.ts",
    "./routes/setup-websocket": "./src/routes/setup-websocket.ts",
    "./sdk-cli-resolver": "./src/lib/agent/sdk-cli-resolver.ts",
    "./lib/agent/sdk-cli-resolver": "./src/lib/agent/sdk-cli-resolver.ts",
    "./lib/data-dir": "./src/lib/data-dir.ts",
    "./lib/drivers/claude-desktop-mods-server": "./src/lib/drivers/claude-desktop-mods-server.ts",
    "./lib/drivers/claude-desktop-mods-runtime": "./src/lib/drivers/claude-desktop-mods-runtime.ts",
    "./lib/drivers/claude-desktop-mods-control": "./src/lib/drivers/claude-desktop-mods-control.ts",
    "./storage/repositories/claude-desktop-bridge": "./src/storage/repositories/claude-desktop-bridge-repository.ts",
    "./storage/repositories/claude-desktop-outbox": "./src/storage/repositories/claude-desktop-outbox-repository.ts",
    "./lib/runtime-server": "./src/lib/runtime-server/index.ts",
    "./lib/internal-event-bus": "./src/lib/internal-event-bus.ts",
    "./lib/internal-command-bus": "./src/lib/internal-command-bus.ts",
    "./lib/internal-query-bus": "./src/lib/internal-query-bus.ts",
    "./lib/acp/mcp-proxy-entry": "./src/lib/acp/mcp-proxy-entry.ts",
    "./lib/drivers/copilot-worker": "./src/lib/drivers/copilot-worker.ts"
  },
  "scripts": {
    "dev": "bun run --watch main.ts",
    "dev:deno": "deno run -A --watch main.ts",
    "start": "NODE_ENV=production bun run main.ts",
    "test": "bun run test:unit && bun run test:online",
    "test:unit": "cd ../.. && ./scripts/test-daemon.sh",
    "test:unit:all": "cd ../.. && ./scripts/test-daemon.sh",
    "test:unit:coverage": "cd ../.. && ./scripts/test-daemon.sh --coverage",
    "test:unit:rerun": "cd ../.. && ./scripts/test-daemon.sh --rerun",
    "test:online": "bun test --coverage --coverage-reporter=text ./tests/online"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.302",
    "@anthropic-ai/sdk": "0.125.0",
    "@github/copilot-sdk": "1.0.13",
    "@huggingface/tokenizers": "0.1.3",
    "@huggingface/transformers": "4.2.0",
    "@hyperneo/prompts": "workspace:*",
    "@hyperneo/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "croner": "10.0.1",
    "hast-util-from-parse5": "8.0.3",
    "hast-util-to-html": "9.0.5",
    "onnxruntime-node": "1.24.3",
    "parse5": "7.3.0",
    "simple-git": "3.36.0",
    "smol-toml": "1.8.0",
    "superpipe": "0.18.0",
    "tar": "7.5.22",
    "ws": "8.21.3",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "25.8.0",
    "@types/ws": "8.18.1",
    "@types/bun": "1.4.2",
    "@vitest/coverage-v8": "5.0.0",
    "undici": "8.10.2",
    "vitest": "5.0.0"
  }
}
