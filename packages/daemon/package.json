{
  "name": "@hyperneo/daemon",
  "version": "0.39.5",
  "type": "module",
  "license": "Apache-2.0",
  "main": "main.ts",
  "exports": {
    ".": "./main.ts",
    "./app": "./src/app.ts",
    "./config": "./src/config.ts",
    "./routes/setup-websocket": "./src/routes/setup-websocket.ts",
    "./sdk-cli-resolver": "./src/lib/agent/sdk-cli-resolver.ts",
    "./lib/agent/sdk-cli-resolver": "./src/lib/agent/sdk-cli-resolver.ts",
    "./lib/data-dir": "./src/lib/data-dir.ts",
    "./lib/internal-event-bus": "./src/lib/internal-event-bus.ts",
    "./lib/internal-command-bus": "./src/lib/internal-command-bus.ts",
    "./lib/internal-query-bus": "./src/lib/internal-query-bus.ts",
    "./lib/acp/mcp-proxy-entry": "./src/lib/acp/mcp-proxy-entry.ts"
  },
  "scripts": {
    "dev": "bun run --watch main.ts",
    "start": "NODE_ENV=production bun run main.ts",
    "test": "bun run test:unit && bun run test:online",
    "test:unit": "cd ../.. && ./scripts/test-daemon.sh",
    "test:unit:all": "cd ../.. && ./scripts/test-daemon.sh",
    "test:unit:coverage": "cd ../.. && ./scripts/test-daemon.sh --coverage",
    "test:unit:rerun": "cd ../.. && ./scripts/test-daemon.sh --rerun",
    "test:online": "bun test --coverage --coverage-reporter=text ./tests/online"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.233",
    "@anthropic-ai/sdk": "0.93.0",
    "@github/copilot-sdk": "0.3.0",
    "@huggingface/transformers": "4.2.0",
    "@hyperneo/prompts": "workspace:*",
    "@hyperneo/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "croner": "10.0.1",
    "simple-git": "3.36.0",
    "superpipe": "0.17.0",
    "ws": "8.18.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "@types/bun": "1.3.14",
    "@vitest/coverage-v8": "4.1.5",
    "undici": "7.15.0",
    "vitest": "4.1.5"
  }
}
