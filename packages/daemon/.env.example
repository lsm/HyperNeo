# HyperNeo Environment Configuration
#
# This file is automatically loaded by Bun at startup.
# Copy to .env and customize for your environment.
# Bun loads files in order: .env → .env.local (later overrides earlier)
#
# No dotenv package needed - Bun has built-in .env support!

# Server Configuration
PORT=9283
HOST=0.0.0.0

# Database
# DB_PATH=./data/daemon.db

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Authentication
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# Kai auto-discovers credentials from Claude Code. If you've
# already logged in with `claude login`, no configuration needed.
#
# Credential discovery order:
#   1. Environment variables (this file or shell exports)
#   2. ~/.claude/.credentials.json (Claude Code login)
#   3. macOS Keychain (Claude Code login)
#   4. ~/.claude/settings.json env block (third-party providers)
#
# To set credentials manually, use ONE of these:

# Option 1: Anthropic API Key
# ANTHROPIC_API_KEY=sk-ant-...

# Option 2: Claude Code OAuth Token (from `claude setup-token`)
# CLAUDE_CODE_OAUTH_TOKEN=...

# Option 3: Third-party provider (configure in ~/.claude/settings.json)
# See: https://docs.anthropic.com/en/docs/claude-code/settings

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# GitHub Copilot provider (anthropic-copilot)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# GitHub token used by the Copilot provider (optional — the provider can
# also discover a token from ~/.copilot/apps.json or GITHUB_TOKEN).
# COPILOT_GITHUB_TOKEN=ghp_...
#
# Linux local-dev note: the Copilot CLI subprocess requires node:sqlite
# (Node.js >= 22.5.0). On Linux, Bun does not supply this module, so the
# system `node` on PATH must be >= 22.5 (Node.js 22 LTS or Node.js 24
# recommended). macOS users are unaffected — Bun on macOS supports node:sqlite
# and is automatically used as the subprocess runtime.

# Model Configuration
DEFAULT_MODEL=default
MAX_TOKENS=8192
TEMPERATURE=1.0
MAX_SESSIONS=10

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SDK Startup Tuning
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# How long (ms) to wait for the SDK subprocess to emit its first message
# before declaring a startup timeout. Increase on slow machines or when
# running many concurrent sessions.
# Default: 60000 (raised from 15000 — cold npx/SDK spawns under concurrent
# start load routinely exceed 15 s; see #2549)
# HYPERNEO_SDK_STARTUP_TIMEOUT_MS=60000
# Note: ACP providers keep a separate 15000 default under this same variable
# (see DEFAULT_STARTUP_TIMEOUT_MS in acp-query-runner.ts).
#
# Exponential backoff base (ms) for automatic startup-timeout retries of one
# delivery: retry n waits base x 2^(n-1) (15s -> 30s -> 60s -> 120s -> 240s at
# the default). Immediate retries regenerate the concurrent-start load that
# causes startup timeouts (e.g. after a daemon restart), so they back off.
# Set 0 to retry immediately with no backoff wait (still capped by
# HYPERNEO_SDK_STARTUP_RETRY_MAX below; the pre-backoff behavior additionally
# retried only once).
# Scope: the standard SDK runner only — ACP sessions use the separate ACP
# startup-retry path, which these knobs do not govern. Note: a follow-up sent
# mid-backoff parks until the turn settles (bounded ~5 min); raising the base
# lengthens the backoff windows and with them the chance a parked follow-up
# hits its park bound and surfaces failed instead of waiting the turn out.
# Default: 15000
# HYPERNEO_SDK_STARTUP_RETRY_BASE_MS=15000
#
# Max consecutive startup-timeout retries per delivered message before the
# retry gives up and the failure is surfaced for the delivery layer to settle
# instead of looping. The budget is per message and survives in-process
# redrives of the same message; a daemon restart starts fresh. Same ACP scope
# caveat as the base knob above. Note: the older
# HYPERNEO_SDK_STARTUP_MAX_RETRIES knob (removed silent auto-recovery, see
# docs/plans/fix-model-switching-bugs-*.md) is unrelated and stays retired.
# Default: 5
# HYPERNEO_SDK_STARTUP_RETRY_MAX=5

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# File Index Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# How often (ms) the workspace file index polls for changes.
# Lower values give faster cache freshness at the cost of more I/O.
# Default: 10000
# HYPERNEO_FILE_INDEX_POLL_MS=10000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Job Queue Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# Maximum number of jobs that can run concurrently across all queues.
# Increase if you have many background tasks (GitHub polling, room ticks,
# session title generation) that need to run in parallel.
# Default: 5
# HYPERNEO_JOB_QUEUE_MAX_CONCURRENT=5

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Structured Log Files
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# The daemon writes redacted JSONL logs to ~/.hyperneo/logs/daemon.jsonl.
# Set the path to 0 or off to disable file logging.
# HYPERNEO_LOG_FILE=/path/to/daemon.jsonl
# HYPERNEO_LOG_MAX_BYTES=10485760
# HYPERNEO_LOG_RETAINED_FILES=5
# HYPERNEO_LOG_MAX_PENDING_BYTES=2097152

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Neo Agent Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# Set to 1 to enable Neo agent provisioning in NODE_ENV=test environments
# (e.g., online tests that exercise the neo.* RPC surface).
# In production/development, Neo is always provisioned at startup.
# HYPERNEO_ENABLE_NEO_AGENT=1

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# MCP Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# Kill switch for M1 of the MCP unification plan
# (docs/plans/unify-mcp-config-model/00-overview.md).
#
# As of M1, every session type spawns with `strictMcpConfig: true` and
# `settingSources: []`, which stops the Claude Agent SDK from auto-loading
# project `.mcp.json` and `.claude/settings.local.json`. Those MCP servers
# must now flow through the HyperNeo registry (app_mcp_servers).
#
# Set HYPERNEO_LEGACY_MCP_AUTOLOAD=1 to restore the pre-M1 asymmetry: room_chat
# and space_chat coordinators stay strict, but workers, task agents and Space
# ad-hoc sessions retain `settingSources: ['project', 'local']` and the SDK
# will auto-load `.mcp.json` as before.
#
# This flag is a single-release escape hatch and will be REMOVED in M5.
# Only the exact string "1" activates it — anything else is treated as unset.
# HYPERNEO_LEGACY_MCP_AUTOLOAD=1

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Debugging
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# Throw a hard error when a workflow session is missing expected MCP servers
# (node-agent or space-agent-tools) at query start. Useful for reproducing
# "No such tool available" failures during local development. In production
# the daemon emits a structured warning event instead.
# HYPERNEO_DEBUG_MCP_INVARIANTS=1

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Test Configuration
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# These options control how online tests mock AI API calls.

# Dev Proxy (realistic HTTP mocking, requires dev-proxy installed)
# HYPERNEO_USE_DEV_PROXY=1
# When using Dev Proxy, also set:
# HTTPS_PROXY=http://127.0.0.1:8000
# HTTP_PROXY=http://127.0.0.1:8000
# NODE_USE_ENV_PROXY=1
# NODE_EXTRA_CA_CERTS=~/.proxy/rootCA.pem
