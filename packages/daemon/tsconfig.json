{
  "compilerOptions": {
    "lib": ["ESNext"],
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@hyperneo/shared": ["../shared/src/mod.ts"],
      "@hyperneo/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src/**/*", "main.ts", "../shared/src/**/*", "research-context-info.ts"],
  "exclude": ["node_modules", "dist", "tests/**/*", "test-*.ts"]
}
