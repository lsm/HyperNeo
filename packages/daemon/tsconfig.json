{
  "compilerOptions": {
    "lib": ["ESNext"],
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["bun"],
    "paths": {
      "@/*": ["./src/*"],
      "@hyperneo/extensions-hooks": ["../extensions/hooks/src/index.ts"],
      "@hyperneo/extensions-hooks/*": ["../extensions/hooks/src/*"],
      "@hyperneo/shared": ["../shared/src/mod.ts"],
      "@hyperneo/shared/*": ["../shared/src/*"]
    }
  },
  "include": [
    "src/**/*",
    "main.ts",
    "../shared/src/**/*",
    "../extensions/hooks/src/**/*",
    "research-context-info.ts"
  ],
  "exclude": ["node_modules", "dist", "tests/**/*", "test-*.ts"]
}
