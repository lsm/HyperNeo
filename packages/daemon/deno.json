{
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitOverride": false,
    "skipLibCheck": true,
    "types": ["bun", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@hyperneo/prompts": ["../prompts/src/mod.ts"],
      "@hyperneo/prompts/*": ["../prompts/src/*"],
      "@hyperneo/shared": ["../shared/src/mod.ts"],
      "@hyperneo/shared/*": ["../shared/src/*"]
    }
  }
}
