{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "external-links",
  "description": "Lets the local daemon open external web links with the system handler",
  "windows": ["main"],
  "remote": {
    "urls": ["http://localhost:*/*", "http://127.0.0.1:*/*"]
  },
  "permissions": ["shell:allow-open"]
}
