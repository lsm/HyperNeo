{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["make", "pgrep", "mkfifo", "devproxy"],
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.ts"],
      "project": ["scripts/**/*.ts"],
      "ignoreDependencies": ["typescript7"]
    },
    "packages/cli": {
      "entry": ["main.ts", "daemon-entry.ts", "prod-entry.ts", "tests/**/*.ts"],
      "project": ["**/*.ts"]
    },
    "packages/daemon": {
      "entry": [
        "main.ts",
        "vitest.online.config.ts",
        "scripts/**/*.ts",
        "tests/**/*.ts",
        "claude-desktop-bridge/hooks/register.ts",
        "src/lib/db-query/db-query-worker.ts",
        "src/lib/event-loop-watchdog-worker.ts",
        "src/lib/message-search-merge-worker.ts",
        "src/lib/message-search-worker.ts",
        "src/lib/neo/project-mirror-worker.ts",
        "src/lib/voice/stream-relay-worker.ts",
        "src/storage/db-gateway/db-gateway-worker.ts",
        "src/storage/repositories/agent-memory-embed-worker.ts",
        "src/storage/sdk-message-body-admission-worker.ts",
        "src/storage/sdk-message-body-backup-worker.ts",
        "src/storage/sdk-status-worker.ts"
      ],
      "project": ["**/*.ts"]
    },
    "packages/messaging": {
      "entry": ["tests/**/*.ts"],
      "project": ["**/*.ts"]
    },
    "packages/prompts": {
      "project": ["**/*.ts"]
    },
    "packages/shared": {
      "entry": ["tests/**/*.ts"],
      "project": ["**/*.ts"]
    },
    "packages/ui": {
      "entry": ["tests/**/*.{ts,tsx}", "demo/**/*.{ts,tsx}"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/web": {
      "entry": [
        "src/client.tsx",
        "src/neo/client.tsx",
        "src/queue-preview.tsx",
        "src/index.ts",
        "src/server-prod.ts",
        "tests/**/*.{ts,tsx}",
        "src/**/__tests__/**/*.{ts,tsx}"
      ],
      "project": ["**/*.{ts,tsx}"],
      "ignoreDependencies": ["typescript7"]
    }
  },
  "ignoreIssues": {
    "packages/shared/src/sdk/sdk.d.ts": ["unlisted"],
    "packages/shared/src/sdk/sdk-tools.d.ts": ["unlisted"],
    "package.json": ["devDependencies"],
    "packages/ui/package.json": ["devDependencies"],
    "packages/web/package.json": ["devDependencies"]
  }
}
