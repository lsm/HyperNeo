{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreBinaries": ["make", "pgrep", "mkfifo", "devproxy"],
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.ts"],
      "project": ["scripts/**/*.ts"],
      "ignoreDependencies": ["typescript7"]
    },
    "packages/cli": {
      "entry": ["main.ts", "daemon-entry.ts", "prod-entry.ts", "tests/**/*.ts"],
      "project": ["**/*.ts"]
    },
    "packages/daemon": {
      "entry": ["main.ts", "vitest.online.config.ts", "scripts/**/*.ts", "tests/**/*.ts"],
      "project": ["**/*.ts"]
    },
    "packages/messaging": {
      "entry": ["tests/**/*.ts"],
      "project": ["**/*.ts"]
    },
    "packages/prompts": {
      "project": ["**/*.ts"]
    },
    "packages/shared": {
      "entry": ["tests/**/*.ts"],
      "project": ["**/*.ts"]
    },
    "packages/ui": {
      "entry": ["tests/**/*.{ts,tsx}", "demo/**/*.{ts,tsx}"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/web": {
      "entry": [
        "src/client.tsx",
        "src/queue-preview.tsx",
        "src/index.ts",
        "src/server-prod.ts",
        "build.ts",
        "tests/**/*.{ts,tsx}",
        "src/**/__tests__/**/*.{ts,tsx}"
      ],
      "project": ["**/*.{ts,tsx}"],
      "ignoreDependencies": ["typescript7"]
    }
  },
  "ignoreIssues": {
    "packages/shared/src/sdk/sdk.d.ts": ["unlisted"],
    "packages/shared/src/sdk/sdk-tools.d.ts": ["unlisted"],
    "package.json": ["devDependencies"],
    "packages/daemon/src/lib/agents/custom-agent.ts": ["exports"],
    "packages/daemon/src/lib/external-events/github/index.ts": ["exports"],
    "packages/daemon/src/lib/external-events/index.ts": ["exports"],
    "packages/daemon/src/lib/github/connectors/index.ts": ["exports"],
    "packages/daemon/src/lib/mcp/index.ts": ["exports"],
    "packages/daemon/src/lib/rpc-handlers/index.ts": ["exports"],
    "packages/daemon/src/lib/space/index.ts": ["files"],
    "packages/daemon/src/storage/schema/index.ts": ["exports"],
    "packages/daemon/tests/online/glm/glm-provider.test.ts": ["unresolved"],
    "packages/daemon/tests/unit/5-space/runtime/session-kind-injected-text.test.ts": ["unresolved"],
    "packages/daemon/tests/unit/5-space/runtime/session-kind-mcp-servers.test.ts": ["unresolved"],
    "packages/shared/src/types/neo-conversation-ask.ts": ["unresolved"],
    "packages/ui/package.json": ["devDependencies"],
    "packages/ui/src/internal/stack-machine.ts": ["exports"],
    "packages/web/build.ts": ["binaries"],
    "packages/web/package.json": ["binaries"],
    "packages/web/src/components/ToolsModal.utils.ts": ["exports"],
    "packages/web/src/components/settings/CustomEndpointsSettings.tsx": ["exports"],
    "packages/web/src/components/space/glass-workspace.tsx": ["exports"],
    "packages/web/src/components/space/index.ts": ["files"],
    "packages/web/src/components/space/template-tools.ts": ["exports"],
    "packages/web/src/components/space/thread/minimal/minimal-mock-data.ts": ["exports"],
    "packages/web/src/components/space/thread/space-task-thread-events.ts": ["exports"],
    "packages/web/src/components/space/visual-editor/index.ts": ["files"],
    "packages/web/src/components/ui/EmptyState.tsx": ["files"],
    "packages/web/src/components/ui/RejectModal.tsx": ["files"],
    "packages/web/src/hooks/index.ts": ["exports"],
    "packages/web/src/lib/recent-paths.ts": ["exports"],
    "packages/web/src/lib/router.ts": ["exports"],
    "packages/web/src/lib/task-constants.ts": ["exports"],
    "packages/web/src/neo/NeoIcon.tsx": ["exports"],
    "packages/web/src/neo/NeoWorkCard.tsx": ["exports"],
    "packages/web/src/neo/neo-project-board.ts": ["exports"],
    "scripts/neo-route-eval/backends.ts": ["unlisted"]
  }
}
