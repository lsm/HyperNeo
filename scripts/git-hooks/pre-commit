#!/bin/bash
#
# Pre-commit hook for HyperNeo
# Runs lint, format check, type checking, and knip before allowing commit
#

set -e

# Docs-only commits skip code checks, by the same rule as the CI path filter.
# Older checkouts without the rule file run the full checks.
inert_docs="$(git rev-parse --show-toplevel)/scripts/lib/inert-docs.sh"
if [ -f "$inert_docs" ]; then
    . "$inert_docs"
    if git diff --cached --name-only --no-renames | all_inert_docs; then
        echo "📝 Only docs staged; skipping code checks."
        exit 0
    fi
fi

echo "🔍 Running pre-commit checks..."

# Run lint
echo "📋 Running lint..."
bun run lint
if [ $? -ne 0 ]; then
    echo "❌ Lint failed. Please fix linting errors before committing."
    echo "💡 You can run 'bun run lint:fix' to auto-fix some issues."
    exit 1
fi

# Run format check
echo "🎨 Checking formatting..."
bun run format:check
if [ $? -ne 0 ]; then
    echo "❌ Formatting check failed. Please format your code before committing."
    echo "💡 Run 'bun run format' to fix formatting."
    exit 1
fi

# Run type check
echo "🔧 Running type check..."
typecheck_output=$(mktemp "${TMPDIR:-/tmp}/hyperneo-typecheck.XXXXXX")
trap 'rm -f "$typecheck_output"' EXIT
bun run typecheck 2>&1 | tee "$typecheck_output"

# Check the exit code of typecheck command
TYPECHECK_EXIT_CODE=${PIPESTATUS[0]}

if [ $TYPECHECK_EXIT_CODE -ne 0 ]; then
    # Count errors by package
    CLI_SRC_ERRORS=$(grep -E "packages/cli/src/" "$typecheck_output" | grep -v "/tests/" | grep "error TS" | wc -l)
    DAEMON_SRC_ERRORS=$(grep -E "packages/daemon/src/" "$typecheck_output" | grep -v "/tests/" | grep "error TS" | wc -l)
    SHARED_SRC_ERRORS=$(grep -E "packages/shared/src/" "$typecheck_output" | grep -v "/tests/" | grep "error TS" | wc -l)
    WEB_ERRORS=$(grep -E "packages/web/" "$typecheck_output" | grep "error TS" | wc -l)
    TEST_ERRORS=$(grep -E "/tests?/" "$typecheck_output" | grep "error TS" | wc -l)

    echo ""
    echo "❌ Type check failed!"
    echo "   CLI src:     $CLI_SRC_ERRORS error(s)"
    echo "   Daemon src:  $DAEMON_SRC_ERRORS error(s)"
    echo "   Shared src:  $SHARED_SRC_ERRORS error(s)"
    echo "   Web package: $WEB_ERRORS error(s)"
    echo "   Test files:  $TEST_ERRORS error(s)"
    echo ""
    echo "💡 Run 'bun run typecheck' to see all errors"
    echo "⚠️  All type errors must be fixed before committing"
    exit 1
fi

# Run knip (dead code detection)
echo "🔎 Running knip (dead code detection)..."
bun run knip || {
    echo "❌  Knip found unused code (see above). Please remove unused code before committing."
    exit 1
}

echo "✅ All pre-commit checks passed!"
exit 0
