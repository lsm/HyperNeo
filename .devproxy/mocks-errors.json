            "type": "invalid_request_error",
            "message": "Prompt is too long: 205616 tokens > 200000 maximum"
          }
        }
      }
    },
    {
      "comment": "Catch-all for recovery flows so that injected /compact and continue-nag turns get a non-overflow success response rather than passing through to the real API.",
      "request": {
        "url": "*/v1/messages*",
        "method": "POST"
      },
      "response": {
        "statusCode": 200,
        "headers": [
          {
            "name": "content-type",
            "value": "application/json"
          },
          {
            "name": "anthropic-ratelimit-requests-limit",
